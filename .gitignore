# .gitignore — Weekend Planner (monorepo kecil: app/ + supabase/ + data/ + docs/)

# Dependencies
node_modules/
app/node_modules/

# Nuxt build output
.nuxt/
.output/
dist/
app/.nuxt/
app/.output/
app/dist/

# Env & secrets — TIDAK PERNAH di-commit. Contohnya ada di app/.env.example
.env
.env.*
!.env.example
app/.env
app/.env.*
!app/.env.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Python (supabase/seed tooling)
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Vercel
.vercel/
